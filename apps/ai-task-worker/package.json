{
  "name": "@saidian-ops/ai-task-worker",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "diagnostics": "powershell -ExecutionPolicy Bypass -File scripts/diagnostics.ps1",
    "install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-windows-task.ps1",
    "upgrade:windows": "powershell -ExecutionPolicy Bypass -File scripts/update-windows-task.ps1",
    "repair:video-metadata": "tsx scripts/repair-video-output-metadata.ts",
    "sync:system-materials": "tsx scripts/sync-system-material-library.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.5.0",
    "gsap": "3.14.2",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
