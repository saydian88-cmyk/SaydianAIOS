{
  "name": "saidian-ops-center",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:api": "pnpm --filter @saidian-ops/api start:dev",
    "dev:ai-task-runner": "pnpm --filter @saidian-ops/ai-task-worker start",
    "dev:video-worker": "pnpm --filter @saidian-ops/api exec tsx src/video-worker.ts",
    "dev:admin": "pnpm --filter @saidian-ops/admin dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @saidian-ops/api prisma:generate",
    "db:migrate": "pnpm --filter @saidian-ops/api prisma:migrate",
    "db:push": "pnpm --filter @saidian-ops/api prisma:push",
    "db:seed": "pnpm --filter @saidian-ops/api prisma:seed",
    "verify:oss": "pnpm --filter @saidian-ops/api exec tsx ../../scripts/verify-oss.ts",
    "sync:assets-agent": "pnpm --filter @saidian-ops/api exec tsx scripts/local-asset-agent.ts",
    "sync:packaging-resources": "pnpm --filter @saidian-ops/api exec tsx scripts/packaging-resource-agent.ts",
    "collector:douyin": "pnpm --filter @saidian-ops/douyin-local-collector start",
    "collector:douyin:install": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/douyin-local-collector/scripts/install-windows-task.ps1",
    "ai-task-runner:install": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/api/scripts/install-ai-task-runner.ps1"
  }
}
