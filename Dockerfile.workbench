FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/workbench/package.json apps/workbench/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile
COPY apps/workbench apps/workbench
RUN VITE_BASE_PATH=/saidian-work/ pnpm --filter @saidian-ops/workbench build

FROM nginx:1.27-alpine
COPY deploy/workbench-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/workbench/dist /usr/share/nginx/html
EXPOSE 80
